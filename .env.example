# Names only. `npm run setup` copies this to the ignored .env.local when that file is missing.
# Nothing in `npm test` or `npm run verify` reads these; they matter only for the tools named on each line.

# Convex CLI (`npm run dev:cloud`). `npx convex dev` writes all three on first login; do not invent them.
# CONVEX_DEPLOYMENT=
# CONVEX_URL=
# CONVEX_SITE_URL=

# OpenRouter for `npm run cli -- --ai` and `npm run chat`. Prefer a key file outside the repo:
# RPM_OPENROUTER_KEY_FILE=   path to a private file containing a line OPENROUTER_API_KEY=...
# OPENROUTER_API_KEY=        read directly only when no key file is given
