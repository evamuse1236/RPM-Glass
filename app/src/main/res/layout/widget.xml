<?xml version="1.0" encoding="utf-8"?>
<!-- Material home-screen widget, a capture bar like Google Keep's: the app icon opens the planner, the pill
     opens Capture ready to type, the mic opens Capture already listening, and the code button at the end opens
     the repo capture (an idea for a repo, filed for Claude and Codex). Check-ins and reminders are just said in Capture. Colours come from res/values*/colors.xml, which mirror android-companion/theme.css. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:minHeight="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    android:clipToOutline="true"
    android:background="@drawable/widget_bg">

    <FrameLayout android:id="@+id/open" android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/widget_action" android:contentDescription="@string/widget_open">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center"
            android:src="@drawable/butterfly" android:importantForAccessibility="no"/>
    </FrameLayout>

    <LinearLayout android:id="@+id/capture" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="48dp" android:layout_marginStart="8dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="4dp"
        android:background="@drawable/widget_pill" android:contentDescription="@string/widget_capture">
        <TextView android:id="@+id/capture_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_capture" android:maxLines="1" android:ellipsize="end"
            android:fontFamily="sans-serif" android:textSize="16sp" android:includeFontPadding="false"
            android:textColor="@color/rpm_on_surface_variant" android:importantForAccessibility="no"/>
        <FrameLayout android:id="@+id/voice" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/widget_round" android:contentDescription="@string/widget_voice">
            <ImageView style="@style/WidgetIcon" android:layout_gravity="center"
                android:src="@drawable/ic_mic" android:tint="@color/rpm_on_primary_container"/>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/repo" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp"
        android:background="@drawable/widget_action" android:contentDescription="@string/widget_repo">
        <ImageView style="@style/WidgetIcon" android:layout_gravity="center"
            android:src="@drawable/ic_code" android:tint="@color/rpm_on_surface_variant"/>
    </FrameLayout>
</LinearLayout>
