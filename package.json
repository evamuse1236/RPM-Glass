{
  "name": "rpm-cloud-sync",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:js && npm run check:rules && npm run test:cloud && npm run typecheck:cloud && npm run test:java",
    "test:js": "node --import ./scripts/test-tz.mjs --test --test-concurrency=4 android-companion/*.test.mjs cli/*.test.mjs chat-prototype/*.test.mjs intent-v2/test/*.test.mjs playground/*.test.mjs web/*.test.mjs web/app/*.test.mjs web/contract/*.test.mjs .claude/skills/verify-rpm-glass/*.test.mjs scripts/capture-stress/*.test.mjs scripts/ci/*.test.mjs scripts/web-sync/*.test.mjs",
    "ci:emulator": "node scripts/ci/emulator.mjs",
    "stress:capture": "node scripts/capture-stress/run.mjs",
    "test:java": "bash scripts/test-parser.sh && node scripts/test-unit.mjs",
    "dev:cloud": "node scripts/web-sync/convex-cli.mjs dev",
    "deploy:cloud": "node scripts/web-sync/convex-cli.mjs deploy",
    "test:cloud": "vitest run",
    "typecheck:cloud": "tsc --noEmit",
    "cli": "node cli/rpm.mjs",
    "capture": "node cli/capture.mjs",
    "chat": "node chat-prototype/companion-server.mjs",
    "playground": "node playground/server.mjs",
    "build:android-assets": "node scripts/build-companion-assets.mjs",
    "check:rules": "node scripts/rules/check-rules.mjs && node --test scripts/rules/*.test.mjs",
    "check:evidence": "node scripts/agent/require-evidence.mjs",
    "check:merge": "node scripts/agent/require-evidence.mjs --merge",
    "hooks:install": "node scripts/agent/install-hooks.mjs",
    "web:stage": "node scripts/web-site/stage.mjs",
    "web:published": "node scripts/web-site/published.mjs",
    "web:build": "node web/build.mjs",
    "web:serve": "node web/serve.mjs",
    "web:phone": "node scripts/web-sync/phone-standin.mjs",
    "web:drive": "node scripts/web-sync/drive.mjs",
    "web:deploy-prod": "node scripts/web-sync/deploy-prod.mjs",
    "web:local": "node scripts/web-sync/local.mjs",
    "web:drive-offline": "node scripts/web-sync/drive-offline.mjs",
    "ramble": "scripts/ramble/ramble.sh",
    "ramble:probe": "RAMBLE_SCRIPT=probe.mjs scripts/ramble/ramble.sh"
  },
  "dependencies": {
    "chrono-node": "2.10.1",
    "convex": "1.48.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.54",
    "esbuild": "0.27.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
