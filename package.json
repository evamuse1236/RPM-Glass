{
  "name": "rpm-cloud-sync",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:js && npm run check:rules && npm run test:cloud && npm run typecheck:cloud && npm run test:java",
    "test:js": "node --import ./scripts/test-tz.mjs --test --test-concurrency=4 android-companion/*.test.mjs cli/*.test.mjs chat-prototype/*.test.mjs intent-v2/test/*.test.mjs playground/*.test.mjs .claude/skills/verify-rpm-glass/*.test.mjs web/**/*.test.mjs",
    "test:java": "bash scripts/test-parser.sh",
    "dev:cloud": "convex dev",
    "deploy:cloud": "convex deploy",
    "test:cloud": "vitest run",
    "typecheck:cloud": "tsc --noEmit",
    "cli": "node cli/rpm.mjs",
    "chat": "node chat-prototype/companion-server.mjs",
    "playground": "node playground/server.mjs",
    "build:android-assets": "node scripts/build-companion-assets.mjs",
    "web:pixel": "node web/pixel/build.mjs",
    "web:serve": "node web/pixel/serve.mjs",
    "web:pixel:shots": "node web/pixel/shots.mjs",
    "web:pixel:flow": "npm run web:pixel && node web/pixel/flow.mjs",
    "check:rules": "node scripts/rules/check-rules.mjs && node --test scripts/rules/*.test.mjs",
    "check:evidence": "node scripts/agent/require-evidence.mjs"
  },
  "dependencies": {
    "chrono-node": "2.10.1",
    "convex": "1.45.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.54",
    "esbuild": "0.27.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
