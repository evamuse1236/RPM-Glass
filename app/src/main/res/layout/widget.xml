<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_gravity="center" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:background="@drawable/widget_bg">
<LinearLayout android:id="@+id/checkin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:padding="4dp" android:orientation="vertical" android:gravity="center" android:contentDescription="@string/widget_checkin" android:background="@drawable/widget_active">
<ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_checkin" android:tint="@color/widget_ink" android:importantForAccessibility="no"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_checkin" android:breakStrategy="high_quality" android:hyphenationFrequency="full" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:includeFontPadding="false" android:textColor="@color/widget_ink" android:paddingTop="2dp" android:importantForAccessibility="no"/>
</LinearLayout>
<LinearLayout android:id="@+id/capture" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:padding="4dp" android:orientation="vertical" android:gravity="center" android:contentDescription="@string/widget_capture">
<ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_capture" android:tint="@color/widget_ink" android:importantForAccessibility="no"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_capture" android:breakStrategy="high_quality" android:hyphenationFrequency="full" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:includeFontPadding="false" android:textColor="@color/widget_ink" android:paddingTop="2dp" android:importantForAccessibility="no"/>
</LinearLayout>
<LinearLayout android:id="@+id/remind" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:padding="4dp" android:orientation="vertical" android:gravity="center" android:contentDescription="@string/widget_remind">
<ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_remind" android:tint="@color/widget_ink" android:importantForAccessibility="no"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_remind" android:breakStrategy="high_quality" android:hyphenationFrequency="full" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:includeFontPadding="false" android:textColor="@color/widget_ink" android:paddingTop="2dp" android:importantForAccessibility="no"/>
</LinearLayout>
<LinearLayout android:id="@+id/open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:padding="4dp" android:orientation="vertical" android:gravity="center" android:contentDescription="@string/widget_open">
<ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_open" android:tint="@color/widget_ink" android:importantForAccessibility="no"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_open" android:breakStrategy="high_quality" android:hyphenationFrequency="full" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:includeFontPadding="false" android:textColor="@color/widget_ink" android:paddingTop="2dp" android:importantForAccessibility="no"/>
</LinearLayout>
</LinearLayout></FrameLayout>